    {
      "name": "2. List Configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/seerbit/Configuration",
          "host": ["{{baseUrl}}"],
          "path": ["seerbit", "Configuration"]
        }
      }
    },
    {
      "name": "3. Create Configuration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"CompanyName\": \"Dev Test Tenant\",\n  \"PublicKey\": \"{{seerbitPublicKey}}\",\n  \"SecretKey\": \"{{seerbitSecretKey}}\",\n  \"Environment\": \"SANDBOX\",\n  \"S4CompanyCode\": \"{{companyCode}}\",\n  \"S4DocumentType\": \"{{documentType}}\",\n  \"S4SoapMode\": \"{{soapMode}}\",\n  \"S4SoapEndpointSync\": \"{{s4SoapEndpointSync}}\",\n  \"S4SoapEndpointAsync\": \"{{s4SoapEndpointAsync}}\",\n  \"S4SoapUser\": \"{{s4SoapUser}}\",\n  \"S4SoapPassword\": \"{{s4SoapPassword}}\",\n  \"S4SoapNamespace\": \"{{s4SoapNamespace}}\",\n  \"S4SoapActionSync\": \"{{s4SoapActionSync}}\",\n  \"S4SoapActionAsync\": \"{{s4SoapActionAsync}}\",\n  \"S4SoapTimeoutMs\": 30000,\n  \"IsActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/seerbit/Configuration",
          "host": ["{{baseUrl}}"],
          "path": ["seerbit", "Configuration"]
        },
        "description": "Create config once, then copy the returned ID into configID environment variable."
      }
    },
