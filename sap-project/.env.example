# SeerBit S/4HANA Integration — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — NEVER commit real credentials.

# ──────────────────────────────────────────
# SeerBit API Credentials
# (Also configurable via /seerbit/Configuration entity)
# ──────────────────────────────────────────
SEERBIT_PUBLIC_KEY=your_public_key_here
SEERBIT_SECRET_KEY=your_secret_key_here
SEERBIT_ENVIRONMENT=SANDBOX   # SANDBOX | LIVE
SEERBIT_AUTH_URL=https://seerbitapi.com/api/v2/encrypt/keys
SEERBIT_ERP_BASE=https://erp.middleware.seerbitapi.com/api/v1
SEERBIT_MERCH_BASE=https://merchant.seerbitapi.com/invoice
SEERBIT_TIMEOUT_MS=30000
SEERBIT_MAX_RETRIES=2
SEERBIT_RETRY_DELAY_MS=350

# ──────────────────────────────────────────
# SAP S/4HANA System Connection
# For local dev, provide direct URL + Basic auth.
# On BTP, use Destination Service instead (set credentials.destination in package.json)
# ──────────────────────────────────────────
S4HANA_URL=https://your-s4hana-host:443
S4HANA_USERNAME=your_s4hana_user
S4HANA_PASSWORD=your_s4hana_password

# ──────────────────────────────────────────
# CAP / Application Settings
# ──────────────────────────────────────────
PORT=4004
NODE_ENV=development   # development | production

# ──────────────────────────────────────────
# SAP BTP (for production deployment)
# ──────────────────────────────────────────
# VCAP_SERVICES is injected automatically by BTP at runtime.
# Set BTP_DESTINATION_NAME to match the destination configured in BTP cockpit.
BTP_DESTINATION_NAME=S4HANA_SYSTEM

# SAP S/4HANA Journal Entry Post SOAP
# Mode: SYNC for Journal Entry - Post (Synchronous), ASYNC for async variant.
S4_JOURNAL_SOAP_MODE=SYNC
S4_JOURNAL_SOAP_ENDPOINT_SYNC=https://your-s4-host/sap/bc/srt/scs_ext/sap/journalentrycreaterequestconfi
S4_JOURNAL_SOAP_ENDPOINT_ASYNC=https://your-s4-host/sap/bc/srt/scs_ext/sap/journalentrycreaterequest
S4_JOURNAL_SOAP_USER=your_s4_soap_user
S4_JOURNAL_SOAP_PASSWORD=your_s4_soap_password
S4_JOURNAL_SOAP_NAMESPACE=http://sap.com/xi/SAPSCORE/SFIN
S4_JOURNAL_SOAP_ACTION_SYNC=http://sap.com/xi/SAPSCORE/SFIN/JournalEntryBulkCreateRequest_In
S4_JOURNAL_SOAP_ACTION_ASYNC=http://sap.com/xi/SAPSCORE/SFIN/JournalEntryBulkCreateRequest_Out
S4_JOURNAL_SOAP_TIMEOUT_MS=30000
